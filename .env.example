# Admin authentication (필수)
# 실제 배포 시 strong secret으로 교체
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
LESSON_ACCESS_SECRET=

# Lesson persistence (Blob 저장소 필수)
BLOB_READ_WRITE_TOKEN=
# 기존 안전한 Blob 저장소를 공유할 때 AI업무학교 전용 prefix
AI_SCHOOL_BLOB_PREFIX=ai-school/production/lessons/
# Blob 저장소 생성 시 선택한 접근 모드: public 또는 private
BLOB_ACCESS=public
# 개발/테스트에서만 허용(운영 금지): true
ALLOW_IN_MEMORY_LESSON_STORAGE=

# 사이트 URL
NEXT_PUBLIC_SITE_URL=
